  "services": {
    "download_images": {
      "name": "Download event images",
      "description": "Saves all images of a ZeroMOUSE event to a folder. Defaults to the latest event.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The ZeroMOUSE device."
        },
        "event_id": {
          "name": "Event ID",
          "description": "Event to download. Leave empty for the latest event."
        },
        "directory": {
          "name": "Directory",
          "description": "Target folder. Leave empty to use the zeromouse folder in your local media folder. Must be an allowed path."
        }
      }
    }
  },
  "exceptions": {
    "auth_failed": {
      "message": "ZeroMOUSE rejected the stored credentials."
    },
    "update_failed": {
      "message": "Error communicating with the ZeroMOUSE cloud: {error}"
    },
    "device_not_found": {
      "message": "The selected device is not a loaded ZeroMOUSE device."
    },
    "directory_not_allowed": {
      "message": "Home Assistant is not allowed to write to {directory}. Use a media folder or add it to allowlist_external_dirs."
    },
    "no_event": {
      "message": "There is no event to download images for."
    },
    "no_images": {
      "message": "No images were found for event {event_id}."
    },
    "download_failed": {
      "message": "Downloading the images failed: {error}"
    }
